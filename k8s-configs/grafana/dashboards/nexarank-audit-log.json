{
  "title": "NexaRank Audit Log",
  "uid": "nexarank-audit-log",
  "tags": ["searchx", "logs", "audit"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Audit events per minute",
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"nexarank-api\"} |= \"AUDIT\" [1m]))",
          "refId": "A",
          "legendFormat": "audit events/min"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "AUDIT log lines (com.nexarank.api.service.AuditService)",
      "description": "Filters nexarank-api pod logs for the literal 'AUDIT' prefix AuditService.recordAction()/recordTier1Action() emit on every rule/user/tenant mutation.",
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 16 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{app=\"nexarank-api\"} |= \"AUDIT\"",
          "refId": "A"
        }
      ]
    }
  ]
}
