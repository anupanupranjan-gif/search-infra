{
  "title": "SearchX SLO Dashboard",
  "uid": "dfg5mznzlenlsc",
  "tags": [
    "searchx",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 99,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;height:100%;font-size:14px;\">\ud83d\udcca Open the <a href=\"/ops\" target=\"_blank\" style=\"color:#7cd3fd;margin-left:6px;\">Observability Console</a> for live metric cards, throughput sparkline, and Prometheus-context AI chat.</div>"
      }
    },
    {
      "id": 1,
      "type": "gauge",
      "title": "Availability SLO (28 Day Rolling)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 98
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 * sum(increase(http_server_requests_seconds_count{application=\"search-api\",uri=\"/api/v1/search\",outcome!=\"SERVER_ERROR\"}[28d])) / sum(increase(http_server_requests_seconds_count{application=\"search-api\",uri=\"/api/v1/search\"}[28d]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Success Rate SLO (>= 99%)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 98
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"search-api\",uri=\"/api/v1/search\",outcome!=\"SERVER_ERROR\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"search-api\",uri=\"/api/v1/search\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Max Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "search_latency_seconds_max{application=\"search-api\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Search Latency p95 and p99",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 2,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(search_latency_seconds_bucket{application=\"search-api\"}[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(search_latency_seconds_bucket{application=\"search-api\"}[5m])) by (le))",
          "refId": "B",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests/sec",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"search-api\",uri=\"/api/v1/search\"}[1m]))",
          "refId": "A",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Avg Latency over time",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(search_latency_seconds_sum{application=\"search-api\"}[5m])) / sum(rate(search_latency_seconds_count{application=\"search-api\"}[5m]))",
          "refId": "A",
          "legendFormat": "avg latency"
        }
      ]
    }
  ]
}
