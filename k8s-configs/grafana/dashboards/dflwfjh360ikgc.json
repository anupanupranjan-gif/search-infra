{
  "title": "Latency Trend",
  "uid": "dflwfjh360ikgc",
  "tags": [
    "searchx",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Search Latency p95 / p99 / avg",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(search_latency_seconds_bucket{application=\"search-api\"}[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(search_latency_seconds_bucket{application=\"search-api\"}[5m])) by (le))",
          "refId": "B",
          "legendFormat": "p99"
        },
        {
          "expr": "sum(rate(search_latency_seconds_sum{application=\"search-api\"}[5m])) / sum(rate(search_latency_seconds_count{application=\"search-api\"}[5m]))",
          "refId": "C",
          "legendFormat": "avg"
        }
      ]
    }
  ]
}
