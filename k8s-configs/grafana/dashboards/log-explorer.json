{
  "title": "Log Explorer",
  "uid": "log-explorer",
  "tags": ["searchx", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "query",
        "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
        "query": "label_values(app)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 2 },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;height:100%;font-size:14px;\">📊 Open the <a href=\"/ops\" target=\"_blank\" style=\"color:#7cd3fd;margin-left:6px;\">Observability Console</a> for live metric cards, throughput sparkline, and Prometheus-context AI chat.</div>"
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Live logs${app:text}",
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "gridPos": { "x": 0, "y": 2, "w": 24, "h": 20 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{namespace=\"default\", app=~\"$app\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
